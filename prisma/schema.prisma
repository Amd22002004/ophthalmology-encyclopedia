generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Disease {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String?
  description String?
  icdCode     String?
  symptoms    String[] @default([])
  diagnostics String?
  treatment   String?
  categoryId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category        DiseaseCategory?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  procedures      DiseaseOnProcedure[]
  doctors         DoctorOnDisease[]
  clinics         ClinicOnDisease[]
  guidelines      DiseaseOnClinicalGuideline[]
  publications    PublicationOnDisease[]
  equipment       DiseaseOnEquipment[]
  scientificWorks ScientificWorkOnDisease[]
  investigations  InvestigationOnDisease[]

  @@index([categoryId])
  @@index([title])
}

model Procedure {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String?
  description String?
  categoryId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category        ProcedureCategory?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  diseases        DiseaseOnProcedure[]
  doctors         DoctorOnProcedure[]
  equipment       ProcedureOnEquipment[]
  publications    PublicationOnProcedure[]
  clinics         ClinicOnProcedure[]
  scientificWorks ScientificWorkOnProcedure[]
  investigations  InvestigationOnProcedure[]

  @@index([categoryId])
  @@index([title])
}

model Doctor {
  id              String   @id @default(cuid())
  slug            String   @unique
  firstName       String
  lastName        String
  middleName      String?
  photoUrl        String?
  position        String? // Публичная должность / специализация (для UI-заголовка)
  category        String? // Группа специализации (для фильтрации)
  credo           String? // Краткое резюме: ключевые операции и направления
  prodoctorovUrl  String? // Ссылка на профиль на prodoctorov.ru
  siteUrl         String? // Ссылка на профиль на официальном сайте клиники
  bio             String?
  career          String?
  experienceYears Int?
  region          String?
  regionId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  regionEntity    Region?                  @relation(fields: [regionId], references: [id], onDelete: SetNull)
  specialties     DoctorOnSpecialty[]
  clinics         DoctorOnClinic[]
  diseases        DoctorOnDisease[]
  procedures      DoctorOnProcedure[]
  publications    Publication[]
  scientificWorks ScientificWork[]
  equipment       DoctorOnEquipment[]
  accountLinks    UserDoctorLink[]
  entityMatches   CooperationEntityMatch[]
  authAuditEvents AuthAuditEvent[]
  eventSpeakers   EventSpeaker[]

  @@index([regionId])
  @@index([lastName, firstName])
}

/// Научная работа врача: диссертация, автореферат, статья, патент,
/// методические рекомендации, монография. Полный текст в БД не хранится —
/// только структурированные данные; сам документ отдаётся файлом (pdfUrl).
enum ScientificWorkSourceStatus {
  FULL_TEXT
  EXTRACTED_PAGES
  SCANNED_PAGES
  BIBLIOGRAPHIC_ONLY
}

enum ScientificWorkContentKind {
  ORIGINAL_RESEARCH
  CLINICAL_CASE
  REVIEW
  THESIS
  OTHER
}

/// Проверенное правовое основание локального размещения файлов. Дата сама по
/// себе недостаточна: публичный gate требует ненулевую категорию основания.
enum ScientificWorkRightsBasis {
  UNVERIFIED
  OPEN_LICENSE
  AUTHOR_PERMISSION
  PUBLISHER_PERMISSION
  USER_CONFIRMED_PERMISSION
  PUBLIC_DOMAIN
}

model ScientificWork {
  id                     String                     @id @default(cuid())
  /// Человекочитаемый идентификатор для страницы /publications/[slug].
  /// Nullable намеренно: добавление NOT NULL-колонки к непустой таблице потребовало бы
  /// деструктивной миграции. Значение всегда проставляется seed'ом; каталог
  /// показывает только работы со slug.
  slug                   String?                    @unique
  doctorId               String
  type                   String // Тип работы: «Кандидатская диссертация», «Патент», ...
  title                  String
  /// Полный список авторов в порядке первичного источника. doctorId остаётся
  /// владельцем работы в графе и не подменяет библиографическое авторство.
  authors                String[]                   @default([])
  /// Индекс связанного врача в упорядоченном authors[]. Нужен для однозначной
  /// Schema.org-ссылки и не выводится сравнением фамилий.
  doctorAuthorIndex      Int?
  bibliography           String?
  journal                String?
  volume                 String?
  issue                  String?
  pages                  String?
  doi                    String?                    @unique
  sourcePageUrl          String?
  sourcePdfUrl           String?
  sourceStatus           ScientificWorkSourceStatus @default(BIBLIOGRAPHIC_ONLY)
  sourceNote             String?
  contentKind            ScientificWorkContentKind  @default(ORIGINAL_RESEARCH)
  topic                  String? // Тема исследования из первичного документа
  degree                 String? // Учёная степень, напр. «Кандидат медицинских наук»
  speciality             String? // Специальность ВАК, напр. «14.01.07 — глазные болезни»
  year                   Int? // Год защиты / публикации
  organization           String? // Место защиты
  supervisor             String? // Научный руководитель
  summary                String? // Краткое описание простым языком (3–5 предложений)
  novelty                String[]                   @default([]) // Научная новизна
  practicalValue         String[]                   @default([]) // Практическая значимость
  results                String[]                   @default([]) // Основные результаты
  conclusions            String[]                   @default([]) // Выводы / практическое значение
  publicationCount       Int? // Число публикаций по теме работы
  pdfUrl                 String? // Полный текст (PDF)
  abstractUrl            String? // Автореферат (PDF)
  images                 String[]                   @default([]) // Иллюстрации из первичного документа
  /// Стабильный slug не означает публикацию. Публичность требует всех трёх
  /// признаков: isPublished, наступивший publishedAt и evidenceValidatedAt.
  isPublished            Boolean                    @default(false)
  evidenceValidatedAt    DateTime?
  publishedAt            DateTime?
  /// Явный редакционный блокер, который нельзя обойти одним переключением
  /// isPublished. Снимается только после устранения указанного противоречия.
  publicationBlockReason String?
  /// Локальные PDF и изображения выводятся только после проверки прав.
  rightsVerifiedAt       DateTime?
  rightsBasis            ScientificWorkRightsBasis  @default(UNVERIFIED)
  rightsNote             String?
  seoTitle               String?
  seoDescription         String?
  sortOrder              Int                        @default(0)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  doctor     Doctor                      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  diseases   ScientificWorkOnDisease[]
  procedures ScientificWorkOnProcedure[]
  equipment  ScientificWorkOnEquipment[]

  @@unique([doctorId, title])
  @@index([doctorId, sortOrder])
  @@index([year])
  @@index([isPublished, evidenceValidatedAt, publishedAt, publicationBlockReason])
  @@index([sourceStatus])
}

/// Заболевание, которое РЕАЛЬНО исследуется в научной работе.
/// Прямая связь, а не через врача: направления автора ≠ тема его работы.
model ScientificWorkOnDisease {
  workId    String
  diseaseId String
  createdAt DateTime @default(now())

  work    ScientificWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  disease Disease        @relation(fields: [diseaseId], references: [id], onDelete: Cascade)

  @@id([workId, diseaseId])
  @@index([diseaseId])
}

/// Процедура/методика, которая РЕАЛЬНО исследуется в научной работе.
model ScientificWorkOnProcedure {
  workId      String
  procedureId String
  createdAt   DateTime @default(now())

  work      ScientificWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  procedure Procedure      @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@id([workId, procedureId])
  @@index([procedureId])
}

/// Оборудование, прямо указанное в научной работе как использованное в методике
/// или клиническом случае. Прямая связь, а не вывод через процедуру.
model ScientificWorkOnEquipment {
  workId      String
  equipmentId String
  createdAt   DateTime @default(now())

  work      ScientificWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  equipment Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([workId, equipmentId])
  @@index([equipmentId])
}

model Clinic {
  id                 String    @id @default(cuid())
  slug               String    @unique
  title              String
  legalName          String?
  description        String?
  city               String?
  region             String?
  regionId           String?
  clinicType         String?
  networkName        String?
  status             String    @default("active")
  phones             String[]  @default([])
  phone              String?
  email              String?
  website            String?
  address            String?
  inn                String?
  kpp                String?
  ogrn               String?
  license            String?
  licenseStatus      String?
  licenseDate        DateTime?
  logoUrl            String?
  coverImageUrl      String?
  facadeImageUrl     String?
  workingHours       String?
  directorName       String?
  latitude           Float?
  longitude          Float?
  mapEmbed           String?
  appointmentUrl     String?
  vkUrl              String?
  telegramUrl        String?
  youtubeUrl         String?
  foundedYear        Int?
  seoTitle           String?
  seoDescription     String?
  seoKeywords        String?
  omsEnabled         Boolean   @default(false)
  contractBased      Boolean   @default(false)
  specializationTags String[]  @default([])
  // Tech Debt: Migrate specializationTags (String[]) to Specialization model + ClinicOnSpecialization relation (Этап 2)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  regionEntity    Region?                  @relation(fields: [regionId], references: [id], onDelete: SetNull)
  specialties     ClinicOnSpecialty[]
  doctors         DoctorOnClinic[]
  suppliers       ClinicOnSupplier[]
  diseases        ClinicOnDisease[]
  procedures      ClinicOnProcedure[]
  publications    ClinicOnPublication[]
  equipment       ClinicOnEquipment[]
  investigations  InvestigationOnClinic[]
  appeals         Appeal[]
  accountAccesses UserClinicAccess[]
  entityMatches   CooperationEntityMatch[]
  authAuditEvents AuthAuditEvent[]

  @@index([regionId])
  @@index([title])
  @@index([status])
  @@index([omsEnabled, contractBased])
}

model Supplier {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  website     String?
  phone       String?
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories SupplierOnEquipmentCategory[]
  equipment  Equipment[]
  clinics    ClinicOnSupplier[]

  @@index([title])
}

model Equipment {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  summary      String?
  description  String?
  manufacturer String? // Производитель, напр. «Carl Zeiss Meditec AG»
  country      String? // Страна производства, напр. «Германия»
  year         Int? // Год появления модели (если достоверно известен)
  principle    String? // Принцип работы
  advantages   String[] @default([]) // Преимущества
  indications  String[] @default([]) // Показания
  limitations  String[] @default([]) // Ограничения / противопоказания
  images       String[] @default([])
  manuals      String[] @default([])
  categoryId   String?
  supplierId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category               EquipmentCategory?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier               Supplier?                        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  specs                  EquipmentSpec[]
  procedures             ProcedureOnEquipment[]
  clinics                ClinicOnEquipment[]
  doctors                DoctorOnEquipment[]
  diseases               DiseaseOnEquipment[]
  investigations         InvestigationOnEquipment[]
  investigationInstances InvestigationEquipmentInstance[]
  scientificWorks        ScientificWorkOnEquipment[]

  @@index([categoryId])
  @@index([supplierId])
  @@index([title])
}

/// Строка таблицы технических характеристик оборудования.
/// Хранится структурно (группа/параметр/значение), а не текстом.
model EquipmentSpec {
  id          String   @id @default(cuid())
  equipmentId String
  group       String? // Группа, напр. «Оптические данные»
  label       String // Параметр, напр. «Длина волны»
  value       String // Значение, напр. «1043 нм»
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([equipmentId, label])
  @@index([equipmentId, sortOrder])
}

model Publication {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  publicationType String?
  publishedAt     DateTime?
  authorName      String?
  abstract        String?
  content         String?
  doctorId        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  doctor     Doctor?                  @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  diseases   PublicationOnDisease[]
  procedures PublicationOnProcedure[]
  clinics    ClinicOnPublication[]

  @@index([doctorId])
  @@index([publishedAt])
  @@index([title])
}

/// Независимое расследование Ассоциации. Содержимое вынесено в отдельные
/// блоки, события и документы, чтобы новые расследования не требовали
/// изменения маршрутов или шаблонов.
model Investigation {
  id                  String    @id @default(cuid())
  slug                String    @unique
  title               String
  summary             String
  status              String
  statusNote          String?
  isPublished         Boolean   @default(false)
  evidenceValidatedAt DateTime?
  publishedAt         DateTime?
  seoTitle            String?
  seoDescription      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sections                      InvestigationSection[]
  timeline                      InvestigationTimelineEvent[]
  documents                     InvestigationDocument[]
  clinics                       InvestigationOnClinic[]
  equipment                     InvestigationOnEquipment[]
  diseases                      InvestigationOnDisease[]
  procedures                    InvestigationOnProcedure[]
  news                          NewsOnInvestigation[]
  equipmentInstances            InvestigationEquipmentInstance[]
  regulatoryAssessments         InvestigationRegulatoryAssessment[]
  independentControlAssessments InvestigationIndependentControlAssessment[]
  registryChecks                InvestigationRegistryCheck[]
  appeals                       Appeal[]

  @@index([isPublished, publishedAt])
  @@index([title])
}

/// Смысловой блок расследования: краткое описание, официальные документы,
/// нормативная база, выводы, статус и другие типы для будущих материалов.
model InvestigationSection {
  id                  String    @id @default(cuid())
  investigationId     String
  key                 String
  title               String
  content             String
  isPublished         Boolean   @default(false)
  evidenceValidatedAt DateTime?
  publishedAt         DateTime?
  sortOrder           Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@unique([investigationId, key])
  @@index([investigationId, sortOrder])
  @@index([investigationId, isPublished, publishedAt, sortOrder])
}

/// Элемент хронологии с отдельной подписью даты: она допускает указание
/// неопределённой или частичной даты без подмены её техническим значением.
model InvestigationTimelineEvent {
  id                  String    @id @default(cuid())
  investigationId     String
  equipmentInstanceId String?
  key                 String
  date                DateTime?
  dateLabel           String
  title               String
  description         String
  isPublished         Boolean   @default(false)
  evidenceValidatedAt DateTime?
  publishedAt         DateTime?
  sortOrder           Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  investigation     Investigation                   @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  equipmentInstance InvestigationEquipmentInstance? @relation(fields: [equipmentInstanceId, investigationId], references: [id, investigationId], onDelete: Restrict)

  @@unique([investigationId, key])
  @@unique([id, investigationId])
  @@index([investigationId, sortOrder])
  @@index([investigationId, isPublished, publishedAt, sortOrder])
  @@index([equipmentInstanceId])
}

/// Первичный документ или доказательная фотография, опубликованные в составе
/// расследования. Техническое имя файла остаётся внутренней метаинформацией и
/// никогда не передаётся в публичный шаблон.
/// `content` хранит доступную текстовую расшифровку для документов, которые
/// браузер не умеет показать встроенно, например DOCX.
model InvestigationDocument {
  id                  String    @id @default(cuid())
  investigationId     String
  slug                String
  kind                String
  title               String
  summary             String?
  source              String?
  documentDate        DateTime?
  storageFileName     String?   @map("sourceFileName")
  fileUrl             String?
  previewImageUrl     String?
  mimeType            String?
  content             String?
  isEvidence          Boolean   @default(true)
  isPublished         Boolean   @default(false)
  evidenceValidatedAt DateTime?
  publishedAt         DateTime?
  sortOrder           Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  investigation              Investigation                             @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  assessmentEvidence         InvestigationAssessmentEvidence[]
  independentControlEvidence InvestigationIndependentControlEvidence[]
  equipmentInstanceEvidence  InvestigationEquipmentInstanceEvidence[]
  registrySnapshots          InvestigationRegistryCheck[]              @relation("InvestigationRegistrySnapshot")

  @@unique([investigationId, slug])
  @@unique([id, investigationId])
  @@index([investigationId, sortOrder])
  @@index([investigationId, isPublished, publishedAt, sortOrder])
  @@index([kind])
}

/// Короткая редакционная новость. Связь вынесена в отдельную таблицу: одна
/// новость может указывать на несколько расследований и наоборот.
model News {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  summary        String
  content        String?
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  investigations NewsOnInvestigation[]

  @@index([isPublished, publishedAt])
  @@index([title])
}

model ClinicalGuideline {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  summary     String?
  content     String?
  sourceUrl   String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  diseases DiseaseOnClinicalGuideline[]

  @@index([publishedAt])
  @@index([title])
}

model Regulation {
  id                     String                @id @default(cuid())
  slug                   String                @unique
  title                  String
  summary                String?
  content                String?
  sourceUrl              String?
  documentType           String?
  number                 String?
  adoptedAt              DateTime?
  issuingAuthority       String?
  jurisdiction           String                @default("Российская Федерация")
  officialPublicationUrl String?
  legalStatus            RegulationLegalStatus @default(DRAFT)
  effectiveFrom          DateTime?
  effectiveTo            DateTime?
  isPublished            Boolean               @default(false)
  publishedAt            DateTime?
  seoTitle               String?
  seoDescription         String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  editions          RegulationEdition[]
  sources           RegulationSource[]
  topics            RegulationOnTopic[]
  outgoingRelations RegulationRelation[] @relation("RegulationRelationSource")
  incomingRelations RegulationRelation[] @relation("RegulationRelationTarget")

  @@index([documentType])
  @@index([legalStatus, isPublished])
  @@index([effectiveFrom])
  @@index([effectiveFrom, effectiveTo])
  @@index([publishedAt])
  @@index([title])
}

enum RegulationLegalStatus {
  DRAFT
  IN_FORCE
  FUTURE
  EXPIRED
}

enum RegulationRelationType {
  AMENDS
  REPEALS
  REPLACES
  EXTENDS
  IMPLEMENTS
}

enum RegulationSourceKind {
  OFFICIAL_PUBLICATION
  OFFICIAL_CONSOLIDATED_TEXT
  OFFICIAL_REGISTER
  OFFICIAL_GUIDANCE
}

enum RegulatoryAssessmentStatus {
  CONFIRMED
  LIKELY_NON_COMPLIANCE
  REQUIRES_VERIFICATION
  NOT_CONFIRMED
  COMPLIANT
}

enum RegulationApplicabilityStatus {
  APPLICABLE
  NOT_APPLICABLE
  REQUIRES_VERIFICATION
}

enum InvestigationEvidenceRole {
  SUPPORTS
  REFUTES
  CONTEXT
}

/// Сигналы, которые требуют проверки, но сами по себе не доказывают нарушение.
enum RestrictedInferenceSignal {
  DOCUMENT_NOT_FOUND
  REGISTRY_NO_MATCH
  OLD_MANUFACTURE_YEAR
  MODEL_DISCONTINUED
  THIRD_PARTY_STATEMENT
}

enum RegistryCheckResult {
  MATCH
  NO_MATCH
  AMBIGUOUS
  UNAVAILABLE
}

enum IndependentControlBasisKind {
  DIRECT_NORM
  METHODOLOGY_DERIVED
  LOCAL_FORM_ONLY
}

enum IndependentControlSourceKind {
  LOCAL_DOCUMENT
  OFFICIAL_METHODOLOGY
  OFFICIAL_GUIDANCE
}

enum IndependentControlRightsBasis {
  UNVERIFIED
  OPEN_LICENSE
  AUTHOR_PERMISSION
  PUBLISHER_PERMISSION
  USER_CONFIRMED_PERMISSION
  PUBLIC_DOMAIN
}

enum IndependentControlNormRole {
  DIRECT_BASIS
  SUPPORTING_BASIS
  HISTORICAL_BASIS
}

/// Конкретная редакция акта. Период хранится независимо от времени обновления
/// карточки, чтобы текущая норма не применялась к историческому событию.
model RegulationEdition {
  id                   String                @id @default(cuid())
  regulationId         String
  key                  String
  title                String?
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  legalStatus          RegulationLegalStatus
  transitionNote       String?
  officialTextUrl      String?
  verifiedAt           DateTime?
  historicalUseAllowed Boolean               @default(false)
  verificationNote     String?
  isPublished          Boolean               @default(false)
  publishedAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  regulation  Regulation                          @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  provisions  RegulationProvision[]
  sources     RegulationSource[]
  assessments InvestigationRegulatoryAssessment[]

  @@unique([regulationId, key])
  @@unique([id, regulationId])
  @@index([regulationId, effectiveFrom, effectiveTo])
  @@index([legalStatus, isPublished])
}

/// Направленная правовая связь: акт-источник изменяет, отменяет, заменяет,
/// продлевает либо реализует акт-цель с указанной датой правового эффекта.
model RegulationRelation {
  id                 String                 @id @default(cuid())
  sourceRegulationId String
  targetRegulationId String
  type               RegulationRelationType
  legalEffectFrom    DateTime?
  note               String?
  officialSourceUrl  String?
  isPublished        Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  sourceRegulation Regulation @relation("RegulationRelationSource", fields: [sourceRegulationId], references: [id], onDelete: Cascade)
  targetRegulation Regulation @relation("RegulationRelationTarget", fields: [targetRegulationId], references: [id], onDelete: Cascade)

  @@unique([sourceRegulationId, targetRegulationId, type, legalEffectFrom])
  @@index([targetRegulationId, type])
}

/// Официальный источник акта или отдельной редакции. Неофициальные пересказы
/// не становятся нормативным основанием расследования.
model RegulationSource {
  id           String               @id @default(cuid())
  regulationId String
  editionId    String?
  kind         RegulationSourceKind
  title        String
  url          String
  isOfficial   Boolean              @default(true)
  isPublished  Boolean              @default(false)
  publishedAt  DateTime?
  sourceDate   DateTime?
  accessedAt   DateTime?
  sortOrder    Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  regulation Regulation         @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  edition    RegulationEdition? @relation(fields: [editionId, regulationId], references: [id, regulationId], onDelete: Cascade)

  @@unique([regulationId, url])
  @@index([editionId])
  @@index([kind, isOfficial])
}

/// Контролируемая тематическая категория нормативного графа.
model RegulationTopic {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  regulations RegulationOnTopic[]
  provisions  RegulationProvision[]

  @@index([isPublished, sortOrder])
  @@index([title])
}

model RegulationOnTopic {
  regulationId String
  topicId      String
  createdAt    DateTime @default(now())

  regulation Regulation      @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  topic      RegulationTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([regulationId, topicId])
  @@index([topicId])
}

/// Атомарное требование конкретной редакции с точным структурным указателем.
model RegulationProvision {
  id            String    @id @default(cuid())
  editionId     String
  topicId       String
  key           String
  locator       String
  title         String
  requirement   String
  applicability String
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  edition               RegulationEdition                @relation(fields: [editionId], references: [id], onDelete: Cascade)
  topic                 RegulationTopic                  @relation(fields: [topicId], references: [id], onDelete: Restrict)
  checks                RegulatoryCheck[]
  equipmentRequirements RegulationEquipmentRequirement[]

  @@unique([editionId, key])
  @@index([editionId, sortOrder])
  @@index([topicId, isPublished])
  @@index([effectiveFrom, effectiveTo])
}

/// Проверочный вопрос превращает норму в рабочую единицу аудита и обязательно
/// указывает, какой факт и каким первичным документом необходимо подтвердить.
model RegulatoryCheck {
  id                   String    @id @default(cuid())
  provisionId          String
  key                  String
  question             String
  factToEstablish      String
  primaryEvidenceType  String
  officialSearchUrl    String?
  officialSearchLabel  String?
  nonCompliancePattern String?
  evidenceThreshold    String?
  applicabilityNote    String?
  isPublished          Boolean   @default(false)
  publishedAt          DateTime?
  sortOrder            Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  provision                  RegulationProvision                 @relation(fields: [provisionId], references: [id], onDelete: Cascade)
  assessments                InvestigationRegulatoryAssessment[]
  independentControlCriteria IndependentControlCriterionNorm[]

  @@unique([provisionId, key])
  @@index([provisionId, isPublished, sortOrder])
}

/// Методика независимого контроля — отдельный ненормативный рабочий инструмент,
/// а не нормативный правовой акт и не замена точной норме RegulatoryCheck.
model IndependentControlMethodology {
  id                     String    @id @default(cuid())
  slug                   String    @unique
  title                  String
  summary                String
  description            String?
  legalStatusNote        String
  bibliographicCitation  String
  officialMethodologyUrl String
  isPublished            Boolean   @default(false)
  evidenceValidatedAt    DateTime?
  publishedAt            DateTime?
  seoTitle               String?
  seoDescription         String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  sources  IndependentControlSource[]
  criteria IndependentControlCriterion[]

  @@index([isPublished, evidenceValidatedAt, publishedAt])
  @@index([title])
}

model IndependentControlSource {
  id                    String                        @id @default(cuid())
  methodologyId         String
  key                   String
  kind                  IndependentControlSourceKind
  title                 String
  bibliographicCitation String?
  sourceUrl             String?
  internalFileName      String?
  sha256                String?
  rightsBasis           IndependentControlRightsBasis @default(UNVERIFIED)
  rightsVerifiedAt      DateTime?
  rightsNote            String?
  publicFileUrl         String?
  isPublished           Boolean                       @default(false)
  evidenceValidatedAt   DateTime?
  publishedAt           DateTime?
  sortOrder             Int                           @default(0)
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  methodology IndependentControlMethodology @relation(fields: [methodologyId], references: [id], onDelete: Cascade)

  @@unique([methodologyId, key])
  @@index([methodologyId, sortOrder])
  @@index([isPublished, evidenceValidatedAt, publishedAt])
}

model IndependentControlCriterion {
  id                   String                       @id @default(cuid())
  methodologyId        String
  key                  String
  sourceLocator        String
  sectionKey           String
  sectionTitle         String
  title                String
  statement            String
  whatIsChecked        String
  checkQuestion        String
  factToEstablish      String
  confirmingDocument   String
  evidenceRequired     String
  evidenceThreshold    String
  applicabilityNote    String
  sourceDivergenceNote String?
  basisKind            IndependentControlBasisKind
  allowedStatuses      RegulatoryAssessmentStatus[] @default([])
  isSourceCriterion    Boolean                      @default(true)
  effectiveFrom        DateTime?
  effectiveTo          DateTime?
  isPublished          Boolean                      @default(false)
  evidenceValidatedAt  DateTime?
  publishedAt          DateTime?
  sortOrder            Int                          @default(0)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  methodology IndependentControlMethodology               @relation(fields: [methodologyId], references: [id], onDelete: Cascade)
  normLinks   IndependentControlCriterionNorm[]
  assessments InvestigationIndependentControlAssessment[]

  @@unique([methodologyId, key])
  @@unique([methodologyId, sourceLocator])
  @@index([isPublished, evidenceValidatedAt, publishedAt])
  @@index([methodologyId, sectionKey, sortOrder])
  @@index([basisKind])
  @@index([effectiveFrom, effectiveTo])
}

model IndependentControlCriterionNorm {
  id                  String                     @id @default(cuid())
  criterionId         String
  regulatoryCheckId   String
  role                IndependentControlNormRole
  verifiedAt          DateTime
  note                String?
  isPublished         Boolean                    @default(false)
  evidenceValidatedAt DateTime?
  publishedAt         DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  criterion       IndependentControlCriterion                 @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  regulatoryCheck RegulatoryCheck                             @relation(fields: [regulatoryCheckId], references: [id], onDelete: Restrict)
  assessments     InvestigationIndependentControlAssessment[]

  @@unique([criterionId, regulatoryCheckId])
  @@unique([id, criterionId])
  @@index([regulatoryCheckId, role])
  @@index([isPublished, evidenceValidatedAt, publishedAt])
}

/// Одна строка стандарта оснащения без обобщения на другие подразделения.
model RegulationEquipmentRequirement {
  id                     String    @id @default(cuid())
  provisionId            String
  stableKey              String
  appendix               String
  subsection             String?
  tableTitle             String?
  position               String
  deviceTypeCode         String?
  regulatoryName         String
  displayName            String?
  quantity               String
  applicabilityCondition String?
  isPublished            Boolean   @default(false)
  publishedAt            DateTime?
  sortOrder              Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  provision RegulationProvision @relation(fields: [provisionId], references: [id], onDelete: Cascade)

  @@unique([provisionId, stableKey])
  @@index([provisionId, sortOrder])
  @@index([deviceTypeCode])
}

/// Конкретный экземпляр оборудования существует только в контексте
/// расследования и не меняет свойства каталожной модели Equipment.
model InvestigationEquipmentInstance {
  id                    String    @id @default(cuid())
  investigationId       String
  equipmentId           String?
  key                   String
  manufacturer          String?
  model                 String
  serialNumber          String?
  manufactureYear       Int?
  acquiredAt            DateTime?
  commissionedAt        DateTime?
  useFrom               DateTime?
  useTo                 DateTime?
  decommissionedAt      DateTime?
  identificationSummary String?
  isPublished           Boolean   @default(false)
  publishedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  investigation          Investigation                            @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  equipment              Equipment?                               @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  assessments            InvestigationRegulatoryAssessment[]
  registryChecks         InvestigationRegistryCheck[]
  identificationEvidence InvestigationEquipmentInstanceEvidence[]
  timelineEvents         InvestigationTimelineEvent[]

  @@unique([investigationId, key])
  @@unique([id, investigationId])
  @@index([equipmentId])
  @@index([serialNumber])
  @@index([investigationId, isPublished, publishedAt])
}

/// Применение одного проверочного вопроса к конкретному факту расследования.
/// Публичный вывод допускается только после отдельного evidence-validation.
model InvestigationRegulatoryAssessment {
  id                                String                        @id @default(cuid())
  investigationId                   String
  regulatoryCheckId                 String
  appliedEditionId                  String?
  clinicId                          String?
  procedureId                       String?
  equipmentInstanceId               String?
  key                               String
  eventFrom                         DateTime?
  eventTo                           DateTime?
  eventDateLabel                    String?
  status                            RegulatoryAssessmentStatus
  applicabilityStatus               RegulationApplicabilityStatus @default(REQUIRES_VERIFICATION)
  restrictedSignals                 RestrictedInferenceSignal[]   @default([])
  neutralConclusion                 String
  alternativeVersion                String
  evidenceGaps                      String?
  supportingEvidenceSearchCompleted Boolean                       @default(false)
  refutingEvidenceSearchCompleted   Boolean                       @default(false)
  isPublished                       Boolean                       @default(false)
  evidenceValidatedAt               DateTime?
  publishedAt                       DateTime?
  createdAt                         DateTime                      @default(now())
  updatedAt                         DateTime                      @updatedAt

  investigation          Investigation                     @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  regulatoryCheck        RegulatoryCheck                   @relation(fields: [regulatoryCheckId], references: [id], onDelete: Restrict)
  appliedEdition         RegulationEdition?                @relation(fields: [appliedEditionId], references: [id], onDelete: SetNull)
  investigationClinic    InvestigationOnClinic?            @relation(fields: [investigationId, clinicId], references: [investigationId, clinicId], onDelete: Restrict)
  investigationProcedure InvestigationOnProcedure?         @relation(fields: [investigationId, procedureId], references: [investigationId, procedureId], onDelete: Restrict)
  equipmentInstance      InvestigationEquipmentInstance?   @relation(fields: [equipmentInstanceId, investigationId], references: [id, investigationId], onDelete: Restrict)
  evidence               InvestigationAssessmentEvidence[]
  registryChecks         InvestigationRegistryCheck[]

  @@unique([investigationId, key])
  @@unique([id, investigationId])
  @@index([regulatoryCheckId, status])
  @@index([appliedEditionId])
  @@index([clinicId])
  @@index([procedureId])
  @@index([equipmentInstanceId])
  @@index([isPublished, evidenceValidatedAt, publishedAt])
}

model InvestigationAssessmentEvidence {
  investigationId      String
  assessmentId         String
  documentId           String
  role                 InvestigationEvidenceRole
  isPrimary            Boolean                   @default(false)
  provenanceVerifiedAt DateTime?
  note                 String?
  createdAt            DateTime                  @default(now())

  assessment InvestigationRegulatoryAssessment @relation(fields: [assessmentId, investigationId], references: [id, investigationId], onDelete: Cascade)
  document   InvestigationDocument             @relation(fields: [documentId, investigationId], references: [id, investigationId], onDelete: Cascade)

  @@id([assessmentId, documentId])
  @@index([documentId, role])
}

model InvestigationIndependentControlAssessment {
  id                                String                        @id @default(cuid())
  investigationId                   String
  criterionId                       String
  appliedCriterionNormId            String?
  clinicId                          String?
  key                               String
  eventFrom                         DateTime?
  eventTo                           DateTime?
  eventDateLabel                    String?
  status                            RegulatoryAssessmentStatus
  applicabilityStatus               RegulationApplicabilityStatus @default(REQUIRES_VERIFICATION)
  restrictedSignals                 RestrictedInferenceSignal[]   @default([])
  neutralConclusion                 String
  alternativeVersion                String
  evidenceGaps                      String?
  supportingEvidenceSearchCompleted Boolean                       @default(false)
  refutingEvidenceSearchCompleted   Boolean                       @default(false)
  isPublished                       Boolean                       @default(false)
  evidenceValidatedAt               DateTime?
  publishedAt                       DateTime?
  createdAt                         DateTime                      @default(now())
  updatedAt                         DateTime                      @updatedAt

  investigation        Investigation                             @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  criterion            IndependentControlCriterion               @relation(fields: [criterionId], references: [id], onDelete: Restrict)
  appliedCriterionNorm IndependentControlCriterionNorm?          @relation(fields: [appliedCriterionNormId, criterionId], references: [id, criterionId], onDelete: Restrict)
  investigationClinic  InvestigationOnClinic?                    @relation(fields: [investigationId, clinicId], references: [investigationId, clinicId], onDelete: Restrict)
  evidence             InvestigationIndependentControlEvidence[]

  @@unique([investigationId, key])
  @@unique([id, investigationId])
  @@index([criterionId, status])
  @@index([appliedCriterionNormId])
  @@index([clinicId])
  @@index([isPublished, evidenceValidatedAt, publishedAt])
}

/// Доказательная связь использует составные FK с investigationId и тем самым
/// запрещает смешивать оценку и документ из разных Investigation.
model InvestigationIndependentControlEvidence {
  investigationId      String
  assessmentId         String
  documentId           String
  role                 InvestigationEvidenceRole
  isPrimary            Boolean                   @default(false)
  provenanceVerifiedAt DateTime?
  note                 String?
  createdAt            DateTime                  @default(now())

  assessment InvestigationIndependentControlAssessment @relation(fields: [assessmentId, investigationId], references: [id, investigationId], onDelete: Cascade)
  document   InvestigationDocument                     @relation(fields: [documentId, investigationId], references: [id, investigationId], onDelete: Cascade)

  @@id([assessmentId, documentId])
  @@index([documentId, role])
}

/// Первичный документ, которым подтверждены только идентификаторы конкретного
/// экземпляра. Эта связь не переносит на экземпляр правовую оценку.
model InvestigationEquipmentInstanceEvidence {
  investigationId     String
  equipmentInstanceId String
  documentId          String
  note                String?
  evidenceValidatedAt DateTime?
  isPublished         Boolean   @default(false)
  publishedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  equipmentInstance InvestigationEquipmentInstance @relation(fields: [equipmentInstanceId, investigationId], references: [id, investigationId], onDelete: Cascade)
  document          InvestigationDocument          @relation(fields: [documentId, investigationId], references: [id, investigationId], onDelete: Cascade)

  @@id([equipmentInstanceId, documentId])
  @@index([documentId])
  @@index([isPublished, publishedAt, evidenceValidatedAt])
}

/// Воспроизводимая попытка поиска в официальном реестре. NO_MATCH означает
/// только отсутствие результата по сохранённому запросу, а не отсутствие РУ.
model InvestigationRegistryCheck {
  id                  String              @id @default(cuid())
  investigationId     String
  assessmentId        String?
  equipmentInstanceId String?
  snapshotDocumentId  String?
  key                 String
  registryName        String
  query               String
  searchedAt          DateTime
  officialUrl         String
  result              RegistryCheckResult
  resultSummary       String
  isPublished         Boolean             @default(false)
  publishedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  investigation     Investigation                      @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  assessment        InvestigationRegulatoryAssessment? @relation(fields: [assessmentId, investigationId], references: [id, investigationId], onDelete: Restrict)
  equipmentInstance InvestigationEquipmentInstance?    @relation(fields: [equipmentInstanceId, investigationId], references: [id, investigationId], onDelete: Restrict)
  snapshotDocument  InvestigationDocument?             @relation("InvestigationRegistrySnapshot", fields: [snapshotDocumentId, investigationId], references: [id, investigationId], onDelete: Restrict)

  @@unique([investigationId, key])
  @@index([assessmentId])
  @@index([equipmentInstanceId])
  @@index([snapshotDocumentId])
  @@index([result, searchedAt])
}

