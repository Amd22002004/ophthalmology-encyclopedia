# Шаблон окружения. Скопируйте в .env и заполните значения:
#   cp .env.example .env
#
# Сам .env в репозиторий не попадает — здесь только имена переменных и примеры.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Обязательна. Строка подключения к базе.
# Используется приложением, seed и служебными скриптами.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ophthalmology_encyclopedia"

# ── Публичный адрес сайта ────────────────────────────────────────────────────
# Нужен для canonical, OpenGraph и sitemap.
# Если не задан, используется http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Сессии админ-панели ──────────────────────────────────────────────────────
# Обязательна для входа в /admin. Минимум 32 случайных символа.
# Сгенерировать: openssl rand -hex 32
SESSION_SECRET=""

# ── Владелец админ-панели ────────────────────────────────────────────────────
# Нужны только для разового `npm run create-owner`.
# Постоянно в окружении не требуются — раскомментируйте перед запуском команды.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
