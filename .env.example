# Шаблон окружения. Скопируйте в .env и заполните значения:
#   cp .env.example .env
#
# Сам .env в репозиторий не попадает — здесь только имена переменных и примеры.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Обязательна. Строка подключения к базе.
# Используется приложением, seed и служебными скриптами.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ophthalmology_encyclopedia"

# ── Публичный адрес сайта ────────────────────────────────────────────────────
# Нужен для canonical, OpenGraph и sitemap.
# Если не задан, используется http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Сессии админ-панели ──────────────────────────────────────────────────────
# Обязательна для входа в /admin. Минимум 32 случайных символа.
# Сгенерировать: openssl rand -hex 32
SESSION_SECRET=""

# Отдельная cookie boundary для участников личного кабинета. В production
# задайте отдельный случайный секрет минимум 32 символа.
PARTICIPANT_SESSION_SECRET=""

# ── Реестр обращений Ассоциации ─────────────────────────────────────────────
# В production каталог должен находиться вне app root и public/.
# Локально при отсутствии значения используется .data/appeals.
APPEAL_UPLOAD_DIR=""

# Публичные изображения клиник. В production каталог должен быть постоянным,
# вне app root и public/, и раздаваться nginx alias-ом.
CLINIC_UPLOAD_DIR=""

# Отдельный секрет HMAC для обезличенного rate limit. Если не задан, сервер
# использует SESSION_SECRET. Значение не выводить и не хранить в репозитории.
APPEAL_RATE_LIMIT_SECRET=""

# SMTP-копия каждого обращения. Официальный адрес и SMTP не подставляются
# автоматически: заполните утверждённые значения в production env.
APPEAL_SMTP_URL=""
APPEAL_SMTP_FROM=""
APPEAL_NOTIFICATION_EMAIL=""
# Общий список внутренних получателей уведомлений через запятую. Если задан,
# он имеет приоритет над legacy-переменными APPEAL/COOPERATION/EVENT выше.
AOK_NOTIFICATION_EMAILS=""

# Воронка сотрудничества: вложения вне public и отдельный email-outbox.
# При пустом COOPERATION_UPLOAD_DIR используется приватная подпапка
# APPEAL_UPLOAD_DIR/cooperation. Можно временно использовать APPEAL_SMTP_*.
COOPERATION_UPLOAD_DIR=""
COOPERATION_RATE_LIMIT_SECRET=""
COOPERATION_SMTP_URL=""
COOPERATION_SMTP_FROM=""
COOPERATION_NOTIFICATION_EMAIL=""

# Конференции: отдельный outbox и HMAC rate limit. Открытие регистрации требует
# активного EventConsentTemplate с requiresApproval=false.
EVENT_RATE_LIMIT_SECRET=""
EVENT_SMTP_URL=""
EVENT_SMTP_FROM=""
EVENT_NOTIFICATION_EMAIL=""

# Google Sheets: регистрация и PostgreSQL не зависят от этой интеграции.
# По умолчанию отключена; service account не коммитить и не писать в логи.
GOOGLE_EVENT_SHEETS_ENABLED="false"
GOOGLE_EVENT_SHEETS_SPREADSHEET_ID=""
GOOGLE_EVENT_SHEETS_SHEET_NAME="Участники"
GOOGLE_EVENT_SHEETS_SERVICE_ACCOUNT_JSON=""
GOOGLE_EVENT_SHEETS_SERVICE_ACCOUNT_PATH=""

# Закрытый служебный Telegram-бот конференции. По умолчанию отключён.
# Token и secret не коммитить и не записывать в базу данных или логи.
TELEGRAM_EVENT_BOT_ENABLED="false"
TELEGRAM_EVENT_BOT_TOKEN=""
TELEGRAM_EVENT_WEBHOOK_SECRET=""
# Списки Telegram ID через запятую; usernames и названия чатов не используются.
TELEGRAM_EVENT_ALLOWED_CHAT_IDS=""
TELEGRAM_EVENT_ALLOWED_USER_IDS=""
TELEGRAM_EVENT_DEFAULT_CHAT_ID=""
# Допустимые значения PII-режима: MASKED (по умолчанию) или FULL после отдельного
# юридического подтверждения обработки полных контактов в закрытой группе.
TELEGRAM_EVENT_PII_MODE="MASKED"
TELEGRAM_EVENT_ADMIN_BASE_URL="https://oftalmologia.pro/admin"
TELEGRAM_EVENT_PUBLIC_BASE_URL="https://oftalmologia.pro"

# HMAC-secret для обезличенного rate limit auth/invitation/reset.
AUTH_RATE_LIMIT_SECRET=""

# ── Владелец админ-панели ────────────────────────────────────────────────────
# Нужны только для разового `npm run create-owner`.
# Постоянно в окружении не требуются — раскомментируйте перед запуском команды.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
