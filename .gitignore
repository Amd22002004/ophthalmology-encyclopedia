# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.data/

# next.js
/.next/
/out/

# production
/build
/public/uploads/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...кроме шаблона: он нужен для первого запуска (см. Quick Start в README).
# Реальных значений в нём нет — только имена переменных и примеры.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev artifacts
ss-*.png
take-screenshots.*
take-clinic-screenshots.*
*.bundle
dev-err.txt
dev-out.txt
.obsidian/

# ── Локальные настройки инструментов ─────────────────────────────────────────
# .claude/settings.local.json содержит локальные разрешения, включая команды
# доступа к серверу. В репозиторий попадать не должен.
.claude/
.playwright-mcp/
.firecrawl/
.codex/
.vscode/
!.vscode/
.vscode/*
!.vscode/settings.json

# ── Исходные материалы и рабочие черновики ───────────────────────────────────
# Исходники (DOCX/PDF диссертаций, дизайн-макеты) не хранятся в репозитории:
# в public/ лежат только опубликованные файлы.
audit/
data/
!/prisma/data/
!/prisma/data/regulations/
!/prisma/data/regulations/**

# ── Посторонние проекты, лежащие внутри рабочей папки ────────────────────────
free-claude-code/
direct-mcp-ai-project/

# ── Проверочные скриншоты и черновики ────────────────────────────────────────
verify-*.png
doctor-design-*.png
doctor-page-design-*.png
card-C-*
design-snapshot.txt
skills-lock.json

# Разовый скрипт проверки подключения к БД (не часть проекта)
scripts/test-prisma.mjs
# Случайно сохранённый вывод пейджера `less`
/system*
